<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="fridge_rangers_item_action" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">fridge_rangers.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="fridge_rangers.item_view_form" model="ir.ui.view">
        <field name="name">fridge_rangers.item.view.form</field>
        <field name="model">fridge_rangers.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title mw-100">
                        <h1>
                            <field name="name" placeholder="e.g. Pasta leftovers"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="owner_id"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="added_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <record id="fridge_rangers.item_view_list" model="ir.ui.view">
        <field name="name">fridge_rangers.item.view.list</field>
        <field name="model">fridge_rangers.item</field>
        <field name="arch" type="xml">
            <list>
                  <field name="name"/>
                  <field name="owner_id"/>
                  <field name="added_date"/>
                  <field name="expiry_date"/>
                  <field name="state"/>
            </list>
        </field>
    </record>

</odoo>